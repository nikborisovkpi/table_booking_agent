# Telegram MTProto credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=booking_agent

# Telegram accounts / targets
OWNER_TELEGRAM=@your_telegram_username
OWNER_ESCALATION_CHAT=me
TARGET_CHAT=@vlad_dev_7
SELF_TEST_MODE=false

# LLM credentials & models (Google Gemini / GCP OpenAI-compatible endpoint by default;
# you can also point OPENROUTER_BASE_URL to https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=your_gemini_api_key_here
OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_MODEL=gemini-3.8-flash
OPENROUTER_STT_MODEL=gemini-3.8-flash

# Guest & booking baseline facts (agent will NEVER invent facts outside these)
GUEST_NAME=Nikita
PARTY_SIZE=2
BOOKING_TIME=17:00
RESTAURANT_CITY=London
RESTAURANT_TIMEZONE=Europe/London

# Voice synthesis (Edge TTS British voice) & runtime settings
TTS_VOICE=en-GB-RyanNeural
DEBOUNCE_SECONDS=6.0
DECISION_LOG_PATH=logs/decision.log
